# 递归函数：创建文件夹+写入meta.json
function Build-Tree {
    param(
        $node,
        $parentPath
    )
    $currentFolderPath = Join-Path $parentPath $node.name
    # 创建目录
    if(-not (Test-Path $currentFolderPath)){
        New-Item -ItemType Directory -Path $currentFolderPath | Out-Null
    }
    # 生成meta.json
    $metaObj = @{
        name = $node.name
        label = $node.label
        desc = $node.desc
        folders = $node.folders
        files = $node.files
    }
    $metaJson = $metaObj | ConvertTo-Json -Depth 10
    $metaFile = Join-Path $currentFolderPath "meta.json"
    Set-Content -Path $metaFile -Value $metaJson -Encoding utf8

    # 递归子节点
    if($node.children){
        foreach($child in $node.children){
            Build-Tree -node $child -parentPath $currentFolderPath
        }
    }
}

